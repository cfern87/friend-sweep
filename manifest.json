{
  "manifest_version": 3,
  "name": "FriendSweep",
  "version": "1.1.0",
  "description": "Scan your Facebook friends, measure who actually engages with you, and clean up your friend list. Free — data stays in your browser and your own browser sync.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content/fb-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content/graph.js", "content/scanner.js"],
      "css": ["content/scanner.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FriendSweep"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
