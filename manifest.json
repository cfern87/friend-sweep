{
  "manifest_version": 3,
  "name": "Not Another Friend Sweeper",
  "short_name": "Friend Sweeper",
  "version": "1.2.0",
  "description": "See which Facebook friends actually engage with your posts and tidy up your friend list. Friend data stays in your browser.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://notanotherfriendsweeper.com/*",
      "https://www.notanotherfriendsweeper.com/*",
      "https://project--a16a1936-14fb-4d4b-a630-0ff28ec2b152.lovable.app/*",
      "https://project--a16a1936-14fb-4d4b-a630-0ff28ec2b152-dev.lovable.app/*",
      "https://id-preview--a16a1936-14fb-4d4b-a630-0ff28ec2b152.lovable.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "content/fb-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "content/graph.js",
        "content/scanner.js"
      ],
      "css": [
        "content/scanner.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Not Another Friend Sweeper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
